[Unit]
Description=ICICI Breeze trading service
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=breeze
Group=breeze
WorkingDirectory=/opt/breeze/app
EnvironmentFile=-/etc/breeze/breeze.env
ExecStart=/opt/breeze/venv/bin/python /opt/breeze/app/main.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/breeze
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
