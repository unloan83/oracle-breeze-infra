# Terraform working data and local state (state must stay in the OCI backend)
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Local variable/override files can contain credentials or tenancy data
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keys, credentials, and application secrets
*.pem
*.key
.env
.env.*
!.env.example
.oci/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
